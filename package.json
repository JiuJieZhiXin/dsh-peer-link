{
  "name": "@local/dsh-peer-link",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Peer Link - chat and message exchange between DeepSeek Harness instances signed in to the same account.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./relay/*": "./relay/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/*.js",
    "relay/*.js",
    "relay/*.toml",
    "relay/*.md",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
